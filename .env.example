# Copy to .env and fill in. .env is git-ignored.
# Source it before launching Claude Code:  set -a && source .env && set +a

# GCP / Firebase project that owns the GA4 BigQuery export.
BIGQUERY_PROJECT=flor2u

# GA4 export dataset. Created automatically when you link GA4 -> BigQuery.
# Format: analytics_<GA4 property id>. Fill in once the export is enabled.
BIGQUERY_DATASET=analytics_

# Dataset region. Must match what you chose in the Firebase integration UI.
BIGQUERY_LOCATION=EU

# Absolute path to the service-account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=/home/user/flor/.secrets/flor2u-bq-reader.json
