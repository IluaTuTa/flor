# Copy to .env and fill in. .env is git-ignored.
# Source it before launching Claude Code:  set -a && source .env && set +a

# GCP / Firebase project that owns the GA4 BigQuery export.
BIGQUERY_PROJECT=flor2u-prod

# GA4 export dataset. Created automatically when you link GA4 -> BigQuery.
# Format: analytics_<GA4 property id>.
BIGQUERY_DATASET=analytics_123456789

# Dataset region. Must match what you chose in the Firebase integration UI.
BIGQUERY_LOCATION=EU

# Absolute path to the service-account JSON key from 03-create-service-account.sh.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/flor/.secrets/flor2u-bq-reader.json

# Yandex Metrika
YANDEX_METRIKA_COUNTER_ID=32273834
YANDEX_METRIKA_TOKEN=
